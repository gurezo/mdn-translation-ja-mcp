{
  "name": "mdn-translation-ja-mcp",
  "version": "1.0.0",
  "description": "MDN Web Docs Japanese Translation MCP Server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-shared-data.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "inspect": "npx --yes @modelcontextprotocol/inspector node dist/index.js",
    "mdn:trans:review": "node dist/cli/review.js",
    "setup:translated-content-cursor": "node scripts/setup-translated-content-cursor.mjs",
    "docs:clean": "rm -rf docs",
    "docs:build": "npm run docs:clean && typedoc --options typedoc.json",
    "docs:publish": "npm run docs:build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
